# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
ENV/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Type checkers and linters
.mypy_cache/
.ruff_cache/
.dmypy.json

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Notebook clutter
.ipynb_checkpoints/

# Generated artefacts under outputs/ are deliberately TRACKED so the results are
# reviewable on GitHub without running anything. They are regenerated by
# `python run_analysis.py` if ever stale.

# Only ad-hoc local run logs are ignored.
outputs/pkg_run.txt
outputs/pkg_err.txt
outputs/audit.txt
outputs/imp_err.txt
outputs/err.txt
outputs/r.txt
outputs/e.txt

# The assignment brief is committed under docs/assignment/. This rule only blocks
# the duplicate that Word keeps locked in the project root.
/Regression Analysi Datasets lab exercise final.docx
/Refer to the word document attached.txt

# The generated Word report is a SUBMISSION artefact, not source. It is rebuilt
# with `python build_report_docx.py`, so it is deliberately not committed.
/Lab_Assignment_Report_California_Housing.docx
~$*.docx
~$*.docx#

# The report generator is kept out of version control for the same reason:
# python-docx is not a project dependency (see requirements.txt), so this script
# is a local-only submission tool rather than part of the reproducible analysis.
/build_report_docx.py
